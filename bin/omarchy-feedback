#!/bin/bash
#
# omarchy-feedback — record feedback about anything on the Omarchy desktop.
#
# Report (SUPER + ALT + B, or middle-click the bug chip):
#   omarchy-feedback capture [--source key|chip|panel] [--minutes N] [--no-annotate]
#   omarchy-feedback capture --no-form --title T [--kind bug|feature]
#                    [--subject auto|omarchy|app|plugin:<id>] [--description D]   (scripts and agents)
#
# Issues:
#   omarchy-feedback list [--status open|all|<status>] [--json]
#   omarchy-feedback show <id> [--json]      Markdown summary, or the full record as JSON
#   omarchy-feedback set <id> status|notes|title|description|kind <value>
#   omarchy-feedback delete <id>
#   omarchy-feedback open [id]               the web viewer: replay, timeline, markup, export
#   omarchy-feedback export <id> [--md|--pdf] [--out FILE]
#
# Hand-offs:
#   omarchy-feedback handoff rix <id>        Rix (Agent Launcher's chief of staff) triages it as a worker job
#   omarchy-feedback handoff agent <id>      your default coding agent opens in the project folder
#   omarchy-feedback handoff author <id>     a prefilled issue on the project's GitHub (you review and submit)
#   omarchy-feedback handoff request <target> <id> | confirm <n> | decline <n> | targets [id] | pending
#
# Recorder (always on while you are logged in, pauses while the screen is locked):
#   omarchy-feedback arm [seconds] | disarm  screen replay buffer (RAM only, auto-off after 30 min)
#   omarchy-feedback pause | resume          stop / restart the event log
#   omarchy-feedback daemon ensure|status|stop|restart
#   omarchy-feedback snap <file> [minutes]   copy the last N minutes of events into a file
#
# Updates (see docs/update-alerts.md):
#   omarchy-feedback update-check [VERSION] [--force]   is a newer version published? (JSON, cached 6 h)
#   omarchy-feedback update-dismiss <version>           stop offering that version
#   omarchy-feedback update-run [all|install]           terminal: omarchy plugin update, install.sh, recorder restart
#
# Flags: --dry-run  print side-effecting commands instead of running them
#        --json     machine output where supported
set -uo pipefail

# Tools come only from root-owned system folders, never from the caller's PATH, so a
# file in a user-writable folder such as ~/.local/bin cannot stand in for hyprctl,
# python3 or grim. The daemon and every helper inherit this PATH. The test suite may
# put the plugin's own tests/stubs (and nothing else) in front.
OF_USER_PATH=${PATH:-}   # only to check that the user's coding agent exists; never used to run anything
PATH=/usr/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin
export PATH
OF_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
OF_ROOT="$(cd -- "$(dirname -- "$OF_SELF")/.." && pwd)"
[[ -n ${OF_TEST_STUBS:-} && $OF_TEST_STUBS == "$OF_ROOT/tests/stubs" ]] && PATH="$OF_TEST_STUBS:$PATH"
OF_LIB="$OF_ROOT/lib"
OF_VERSION=$(jq -r .version "$OF_ROOT/manifest.json" 2>/dev/null || echo dev)

source "$OF_LIB/common.sh"
source "$OF_LIB/daemon.sh"
source "$OF_LIB/capture.sh"
source "$OF_LIB/issues.sh"
source "$OF_LIB/handoff.sh"
source "$OF_LIB/viewer.sh"
# shellcheck source=/dev/null
[[ -n ${OF_UI_STUBS:-} && $OF_UI_STUBS == "$OF_ROOT/tests/ui-stubs.sh" ]] && source "$OF_UI_STUBS"

usage() { awk 'NR > 2 && /^#/ { sub(/^# ?/, ""); print; next } NR > 2 { exit }' "$OF_SELF"; }

JSON=0 ARGS=()
for a in "$@"; do
  case "$a" in
    --dry-run) OF_DRY_RUN=1 ;;
    --json)    JSON=1 ;;
    -h|--help) usage; exit 0 ;;
    --version) echo "omarchy-feedback $OF_VERSION"; exit 0 ;;
    *)         ARGS+=("$a") ;;
  esac
done
export OF_DRY_RUN JSON
set -- "${ARGS[@]+"${ARGS[@]}"}"

cmd=${1:-help}; shift || true
case "$cmd" in
  capture) cmd_capture "$@" ;;
  capture-form) cmd_capture_form "$@" ;;
  list)   cmd_list "$@" ;;
  show)   cmd_show "$@" ;;
  set)    cmd_set "$@" ;;
  delete) cmd_delete "$@" ;;
  handoff) cmd_handoff "$@" ;;
  open)   cmd_open "$@" ;;
  export) cmd_export "$@" ;;
  arm)    cmd_arm "$@" ;;
  disarm) cmd_disarm ;;
  daemon) cmd_daemon "$@" ;;
  pause)  cmd_pause ;;
  resume) cmd_resume ;;
  snap)   cmd_snap "$@" ;;
  update-check)   exec bash "$OF_LIB/update.sh" check "$@" ;;
  update-dismiss) exec bash "$OF_LIB/update.sh" dismiss "$@" ;;
  update-run)     exec env OMARCHY_PLUGIN_UPDATE_PRINT="${OMARCHY_PLUGIN_UPDATE_PRINT:-${OF_DRY_RUN:-0}}" bash "$OF_LIB/update.sh" run "$@" ;;
  help)   usage ;;
  *) fail "unknown command '$cmd' (try --help)" ;;
esac
