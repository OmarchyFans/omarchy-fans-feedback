#!/bin/bash
# Fake repair agent: reads the prompt on stdin, "fixes" the bug by appending a line.
printf 'claude %s\n' "$*" >>"$BF_TEST_LOG"
cat >"$BF_TEST_DIR/claude-prompt.md"
[[ -n ${BF_AGENT_NOOP:-} ]] && exit 0
echo "# fixed by agent" >>lib/thing.sh
echo "Root cause: x. Change: y. Verified: z."
