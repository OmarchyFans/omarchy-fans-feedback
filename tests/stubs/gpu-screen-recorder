#!/usr/bin/env python3
"""gpu-screen-recorder stub: replay mode with the real -ipc protocol.

Logs its argv, listens on -ipc, answers save-replay by writing a fake
Replay_*.mp4 (+ .ts) into -o and replying with its path, exits on SIGINT or
a stop request. OF_GSR_FAIL=1 makes it exit at once.
"""
import sys

sys.dont_write_bytecode = True

import json  # noqa: E402
import os  # noqa: E402
import signal  # noqa: E402
import socket  # noqa: E402
import time  # noqa: E402

args = sys.argv[1:]
with open(os.environ.get("OF_TEST_LOG", "/dev/null"), "a") as f:
    f.write("gpu-screen-recorder %s\n" % " ".join(args))
if os.environ.get("OF_GSR_FAIL") == "1":
    sys.exit(3)
opt = {args[i]: args[i + 1] for i in range(0, len(args) - 1) if args[i].startswith("-")}
out, ipc = opt.get("-o"), opt.get("-ipc")
signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
try:
    os.unlink(ipc)
except OSError:
    pass
srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
srv.bind(ipc)
srv.listen(4)
n = 0
try:
    while True:
        conn, _ = srv.accept()
        with conn:
            req = json.loads(conn.makefile().readline() or "{}")
            if req.get("name") == "save-replay":
                n += 1
                path = os.path.join(out, "Replay_test_%d.mp4" % n)
                with open(path, "wb") as f:
                    f.write(b"fake-mp4")
                # The real recorder writes no .ts for replay saves (verified live); OF_GSR_TS=1 simulates one.
                if os.environ.get("OF_GSR_TS") == "1":
                    with open(path + ".ts", "w") as f:
                        f.write("monotonic_microsec realtime_microsec\n%d %d\n" % (time.monotonic_ns() // 1000, time.time_ns() // 1000))
                conn.sendall((json.dumps({"id": req.get("id", 0), "result": "ok", "data": path}) + "\n").encode())
            elif req.get("name") == "stop":
                conn.sendall((json.dumps({"id": req.get("id", 0), "result": "ok"}) + "\n").encode())
                break
            else:
                conn.sendall((json.dumps({"id": req.get("id", 0), "result": "error", "data": "unknown"}) + "\n").encode())
finally:
    try:
        os.unlink(ipc)
    except OSError:
        pass
